# Environment & Server
ENVIRONMENT=development
PORT=8000
DEBUG=True
SECRET_KEY=change-this-in-production-to-a-secure-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL (Relational DB)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=acadflow_user
POSTGRES_PASSWORD=acadflow_password
POSTGRES_DB=acadflow_db
DATABASE_URL=postgresql+asyncpg://acadflow_user:acadflow_password@localhost:5432/acadflow_db

# MongoDB (Document DB)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=acadflow_mongo

# Redis (Cache, Sessions, Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ML Service Client
ML_SERVICE_URL=http://localhost:8001
ML_CLIENT_ID=acadflow_backend
ML_CLIENT_SECRET=acadflow_ml_secret

# Monitoring & Tracking
PROMETHEUS_PORT=9090
MLFLOW_TRACKING_URI=http://localhost:5000
