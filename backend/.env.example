# AcadFlow Backend — Environment Variables Example
# Copy this file to .env and fill in your values.

PROJECT_NAME=AcadFlow
VERSION=1.0.0
ENVIRONMENT=development
PORT=8000

# Generate a secure random key for production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=acadflow-insecure-secret-key-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql+psycopg://acadflow_user:acadflow_password@localhost:5432/acadflow_db
MONGO_URI=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379/0
ML_SERVICE_URL=http://localhost:8001

# Security / Rate limiting
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_SECONDS=900
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=5

# CORS — comma-separated list of allowed origins (no wildcard when credentials=true)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
